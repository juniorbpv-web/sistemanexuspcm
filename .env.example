# ==============================================================================
# MAKMO - GESTÃO DE FROTAS & CONTROLE DE COMBUSTÍVEL
# Variáveis de Ambiente para Deploy (Hostinger / Produção)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVIDOR NODE.JS (OPCIONAL se rodar como aplicação Node.js na Hostinger)
# ------------------------------------------------------------------------------
# PORT: Porta em que o servidor Express irá rodar (padrão: 3000 ou injetada pela Hostinger)
PORT=3000

# NODE_ENV: Ambiente de execução ('production' para produção, 'development' para dev)
NODE_ENV=production

# ------------------------------------------------------------------------------
# FIREBASE FIRESTORE & AUTHENTICATION (CLIENTE VITE)
# Se não preenchidas, a aplicação utiliza as credenciais de fallback do arquivo
# firebase-applet-config.json. Para alterar o projeto em produção, preencha abaixo:
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY: Chave pública de API do projeto Firebase
VITE_FIREBASE_API_KEY="AIzaSyC6dipzR1YH6Hvj7wnGx2nWnPSP4BcoYPc"

# VITE_FIREBASE_AUTH_DOMAIN: Domínio de autenticação do Firebase
VITE_FIREBASE_AUTH_DOMAIN="gestao-combustivel-510700.firebaseapp.com"

# VITE_FIREBASE_PROJECT_ID: ID do projeto no Google Cloud / Firebase
VITE_FIREBASE_PROJECT_ID="gestao-combustivel-510700"

# VITE_FIREBASE_STORAGE_BUCKET: Bucket de armazenamento do Firebase
VITE_FIREBASE_STORAGE_BUCKET="gestao-combustivel-510700.firebasestorage.app"

# VITE_FIREBASE_MESSAGING_SENDER_ID: ID do remetente de mensagens Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID="994977001616"

# VITE_FIREBASE_APP_ID: ID da aplicação Web no Firebase
VITE_FIREBASE_APP_ID="1:994977001616:web:d6d3d27a10536919d66815"

# VITE_FIREBASE_MEASUREMENT_ID: ID de métricas do Google Analytics (opcional)
VITE_FIREBASE_MEASUREMENT_ID=""

# VITE_FIREBASE_DATABASE_ID: ID do banco Firestore customizado (opcional, padrão: (default))
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# OUTRAS INTEGRAÇÕES (OPCIONAIS)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Chave da API Google Gemini (caso use recursos de IA adicionais)
GEMINI_API_KEY=""

# APP_URL: URL pública onde a aplicação está hospedada (ex: https://seudominio.com.br)
APP_URL="https://seudominio.com.br"
